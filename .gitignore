# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# OS
.DS_Store

# Local scratch (generated outputs ARE committed for the final submission,
# see guideline.md §5 — only transient files are ignored here)
*.log
.streamlit/secrets.toml
.env
# Secrets — never committed
.env

# Gradio
.gradio/
flagged/

# NOTE: config.calibrated.yaml is deliberately NOT ignored. It holds the
# thresholds the calibrator agent chose and is committed with the submission so
# that the jury's run reproduces exactly those numbers.

# Run logs from go.sh
.run_logs/

# Network maps rendered by the viewer (regenerated on demand)
output_files/_maps/

# Vendored third-party assets for the standalone interface. Copied out of the
# installed pyvis package by web/serve.py on startup, so they are regenerated
# on any machine and do not belong in version control (nor do their licence
# obligations, which travel with pyvis).
web/vendor/

# Gradio's own cache
.gradio/
